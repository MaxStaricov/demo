@startuml SequenceDiagram
title Диаграмма последовательности — Demo (Humanizer DateTimeHumanizeStrategy)

skinparam sequenceMessageAlign center
autonumber "<b>[00]"

actor "Program.cs\n(demo)" as Program

box "Подсистема DateTimeHumanizeStrategy" #LightBlue
    participant "HumanizeExtensions" as Ext
    participant "DefaultDateTime\nHumanizeStrategy" as DefDT
    participant "PrecisionDateTime\nHumanizeStrategy" as PrecDT
    participant "DefaultDateOnly\nHumanizeStrategy" as DefDO
    participant "DefaultTimeOnly\nHumanizeStrategy" as DefTO
    participant "DefaultDateTimeOffset\nHumanizeStrategy" as DefDTO
    participant "«custom»\nRussianishStrategy" as Custom
    participant "DateTimeHumanize\nAlgorithms" as Algo
end box

box "Shim (слой локализации)" #LightYellow
    participant "Configurator" as Conf
    participant "DefaultFormatter\n: IFormatter" as Fmt
end box

== Сегмент 1: Default-стратегия через расширения ==
Program -> Ext : past.Humanize()
note right of Ext : extension-метод для DateTime\ncomparisonBase = DateTime.Now
Ext -> DefDT : Humanize(input, DateTime.Now, culture)
DefDT -> Algo : DefaultHumanize(input, comparisonBase, culture)
Algo -> Algo : ts = |comparisonBase.Ticks - input.Ticks|\ntense = Past / Future
Algo -> Conf : GetFormatter(culture)
Conf --> Algo : DefaultFormatter.Instance
Algo -> Fmt : DateHumanize(TimeUnit.Minute, Past, 14)
Fmt --> Algo : "14 minutes ago"
Algo --> DefDT : "14 minutes ago"
DefDT --> Ext : "14 minutes ago"
Ext --> Program : "14 minutes ago"

== Сегмент 2: Precision-стратегия ==
Program -> PrecDT : new PrecisionDateTimeHumanizeStrategy(0.85)
Program -> PrecDT : Humanize(past, now, null)
PrecDT -> Algo : PrecisionHumanize(input, comparisonBase, 0.85, culture)
Algo -> Algo : округление единиц с точностью precision
Algo -> Conf : GetFormatter(culture)
Conf --> Algo : DefaultFormatter.Instance
Algo -> Fmt : DateHumanize(TimeUnit.Hour, Past, 1)
Fmt --> Algo : "an hour ago"
Algo --> PrecDT : "an hour ago"
PrecDT --> Program : "an hour ago"

== Сегмент 3: Прямое использование стратегии ==
Program -> DefDT : new DefaultDateTimeHumanizeStrategy()
Program -> DefDT : strategy.Humanize(releaseDay, reportDay, null)
DefDT -> Algo : DefaultHumanize(releaseDay, reportDay, null)
Algo -> Conf : GetFormatter(null)
Conf --> Algo : DefaultFormatter.Instance
Algo -> Fmt : DateHumanize(TimeUnit.Month, Past, 1)
Fmt --> Algo : "a month ago"
Algo --> DefDT : "a month ago"
DefDT --> Program : "a month ago"

== Сегмент 4: DateOnly / TimeOnly / DateTimeOffset ==
Program -> Ext : dateOnly.Humanize()
Ext -> DefDO : Humanize(input, DateOnly.FromDateTime(DateTime.Today), culture)
alt input == comparisonBase
    DefDO -> Algo : DefaultHumanize(...)  // ранний выход
    Algo -> Conf : GetFormatter(culture)
    Conf --> Algo : DefaultFormatter.Instance
    Algo -> Fmt : DateHumanize(Millisecond, Past, 0) -> "now"
    Algo -> Fmt : DateHumanize_Today(now)
    Fmt --> Algo : "today"
else разные даты
    Algo -> Fmt : DateHumanize(TimeUnit.Day, tense, days)
end
Algo --> DefDO : результат
DefDO --> Ext : результат
Ext --> Program : "today"

Program -> Ext : timeOnly.Humanize()
Ext -> DefTO : Humanize(input, TimeOnly.FromDateTime(DateTime.Now), culture)
DefTO -> Algo : DefaultHumanize(input, comparisonBase, culture)
Algo -> Conf : GetFormatter(culture)
Conf --> Algo : DefaultFormatter.Instance
Algo -> Fmt : DateHumanize(TimeUnit.Hour, Future, 1)
Fmt --> Algo : "in an hour"
Algo --> DefTO : "in an hour"
DefTO --> Ext : "in an hour"
Ext --> Program : "in an hour"

Program -> Ext : dateTimeOffset.Humanize()
Ext -> DefDTO : Humanize(input, DateTimeOffset.UtcNow, culture)
DefDTO -> DefDTO : перевод в UTC (.UtcDateTime)
DefDTO -> Algo : DefaultHumanize(input.UtcDateTime, base.UtcDateTime, culture)
Algo -> Conf : GetFormatter(culture)
Conf --> Algo : DefaultFormatter.Instance
Algo -> Fmt : DateHumanize(TimeUnit.Hour, Past, 2)
Fmt --> Algo : "2 hours ago"
Algo --> DefDTO : "2 hours ago"
DefDTO --> Ext : "2 hours ago"
Ext --> Program : "2 hours ago"

== Сегмент 5: Кастомная стратегия (расширяемость) ==
Program -> Custom : new RussianishStrategy()
Program -> Custom : Humanize(past2Days, now, InvariantCulture)
note right of Custom : реализует IDateTimeHumanizeStrategy\nне использует Algorithms / Formatter
Custom -> Custom : ts = |ΔTicks|; выбор единицы
Custom --> Program : "2 дн. назад"

@enduml
