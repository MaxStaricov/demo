<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Целевая платформа: .NET 8 — самый широкий охват (8/9/10).
         Если установлен только .NET 10 SDK/Runtime — замените на net10.0 -->
